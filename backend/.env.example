# Copy to .env and fill in. Never commit the real .env file.

# From https://console.groq.com — create a key dedicated to this project (blueprint.md §7).
GROQ_API_KEY=

# Pick from Groq's CURRENT model list (https://console.groq.com/docs/models) during
# Phase 1's model/pricing discovery step — do not assume any model name from this plan
# is still offered. Confirm it supports JSON-mode output reliably.
GROQ_MODEL=

DATABASE_PATH=./data/botarena.db
DEPLOYMENT_MODE=local

# Shared mode only. Use independent random secrets of at least 32 characters.
ADMIN_TOKEN=
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_KEY_VERSION=1
# Explicit CIDRs of the immediate trusted proxy peers; empty means trust no headers.
TRUSTED_PROXY_NETWORKS=
CLIENT_IP_HEADER=Fly-Client-IP
CREATE_QUOTA_PER_IP_24H=10
GLOBAL_CREATE_QUOTA_24H=100
CONCURRENCY_PER_IP=1
GLOBAL_CONCURRENCY=2
